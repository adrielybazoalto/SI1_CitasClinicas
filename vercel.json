{
  "version": 2,
  "framework": "laravel",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/SI1_CitasClinicas/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/SI1_CitasClinicas/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/SI1_CitasClinicas/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}